# Cricket YouTube Live AI Broadcast Configuration

# Broadcast Mode: 'youtube' (pushes to YouTube Live) or 'preview' (saves locally to MP4)
STREAM_MODE=preview

# YouTube Live Ingestion Details
# Find in YouTube Studio -> Go Live -> Stream Key
YOUTUBE_RTMP_BASE=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=

# Local Preview Output Path (used when STREAM_MODE=preview)
OUTPUT_PREVIEW_FILE=broadcast_output.mp4

# Video Resolution and FPS
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2500k

# Audio Settings
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=2
AUDIO_BITRATE=128k

# Commentary NLP Engine
# 'auto', 'gemini' (requires GEMINI_API_KEY), or 'offline' (zero-latency built-in engine)
COMMENTARY_MODE=auto
GEMINI_API_KEY=

# Neural Voice Selection (Microsoft Edge TTS Voices)
# en-IN-PrabhatNeural (Indian English Broadcaster - Ravi Shastri style)
# en-IN-NeerjaNeural (Indian English Female Broadcaster - Isa Guha style)
# en-GB-RyanNeural (English Broadcaster - Nasser Hussain style)
# en-AU-WilliamNeural (Australian Broadcaster - Ricky Ponting style)
TTS_VOICE=en-IN-PrabhatNeural
TTS_RATE=+5%
TTS_PITCH=+0Hz

# Live Event Webhook Port
EVENT_SERVER_HOST=0.0.0.0
EVENT_SERVER_PORT=8080
